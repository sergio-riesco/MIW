        <grammar type="application/srgs+xml" src="codigoPostal.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="codigoPostal != ''">
            <audio src="ok_codigoPostal.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_729"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <field name="importe" type="digits">
        <grammar type="application/srgs+xml" src="importe.grxml"/>
        <prompt>Elija una de las opciones.</prompt>
        <filled>
          <if cond="importe != ''">
            <audio src="ok_importe.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_729"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#acceso1_729"/>
    </block>
  </form>
  <form id="acceso1_729">
    <block>
      <prompt>
        Diga su numero de identidad.
        <break time="300ms"/>
      </prompt>
      <field name="hora" type="date">
        <grammar type="application/srgs+xml" src="hora.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="hora != ''">
            <audio src="ok_hora.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_729"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="correo" type="number">
        <grammar type="application/srgs+xml" src="correo.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="correo != ''">
            <audio src="ok_correo.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_729"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="direccion" type="digits">
        <grammar type="application/srgs+xml" src="direccion.grxml"/>
        <prompt>A que hora prefiere pasar?</prompt>
        <filled>
          <if cond="direccion != ''">
            <audio src="ok_direccion.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_729"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="ciudad" type="boolean">
        <grammar type="application/srgs+xml" src="ciudad.grxml"/>
        <prompt>Puede repetir la informacion?</prompt>
        <filled>
          <if cond="ciudad != ''">
            <audio src="ok_ciudad.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_729"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <exit/>
    </block>
  </form>
</vxml>
