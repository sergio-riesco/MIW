  <form id="reserva_352">
    <block>
      <prompt>
        Gracias por su llamada.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="date">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <filled>
          <goto next="#facturacion_962"/>
        </filled>
      </field>
      <field name="telefono" type="string">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="telefono != ''">
            <audio src="ok_telefono.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_962"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <field name="codigoPostal" type="string">
        <grammar type="application/srgs+xml" src="codigoPostal.grxml"/>
        <prompt>Espere un momento, por favor.</prompt>
        <filled>
          <if cond="codigoPostal != ''">
            <audio src="ok_codigoPostal.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_962"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="importe" type="date">
        <grammar type="application/srgs+xml" src="importe.grxml"/>
        <prompt>A que hora prefiere pasar?</prompt>
        <filled>
          <if cond="importe != ''">
            <audio src="ok_importe.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_962"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#facturacion_962"/>
    </block>
