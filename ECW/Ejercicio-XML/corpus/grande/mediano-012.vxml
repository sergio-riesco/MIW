      <field name="canal" type="digits">
        <grammar type="application/srgs+xml" src="canal.grxml"/>
        <prompt>Elija una de las opciones.</prompt>
        <filled>
          <if cond="canal != ''">
            <audio src="ok_canal.wav">Correcto.</audio>
          </if>
          <goto next="#encuesta1_379"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="motivo" type="boolean">
        <grammar type="application/srgs+xml" src="motivo.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="motivo != ''">
            <audio src="ok_motivo.wav">Correcto.</audio>
          </if>
          <goto next="#encuesta1_379"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="tipo" type="boolean">
        <grammar type="application/srgs+xml" src="tipo.grxml"/>
        <filled>
          <goto next="#encuesta1_379"/>
        </filled>
      </field>
      <goto next="#encuesta1_379"/>
    </block>
  </form>
  <form id="encuesta1_379">
