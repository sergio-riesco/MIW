  <form id="reserva_536">
    <block>
      <prompt>
        Indique el codigo postal.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="digits">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <prompt>A que hora prefiere pasar?</prompt>
        <filled>
          <if cond="dni != ''">
            <audio src="ok_dni.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_987"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#facturacion_987"/>
      <exit/>
    </block>
  </form>
