  <form id="reserva_929">
    <block>
      <prompt>
        EUR 12,50 Confirme los datos, por favor.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="number">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <prompt>Diga su numero de identidad.</prompt>
        <filled>
          <if cond="dni != ''">
            <audio src="ok_dni.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_842"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <goto next="#facturacion_842"/>
    </block>
  </form>
