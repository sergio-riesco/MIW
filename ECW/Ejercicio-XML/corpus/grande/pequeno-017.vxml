<vxml xmlns="http://www.w3.org/2001/vxml" version="2.1" xml:lang="es-ES">
  <form id="reserva_980">
    <block>
      <prompt>
        Le quedan dos intentos.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="string">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <prompt>Puede repetir la informacion?</prompt>
        <filled>
          <if cond="dni != ''">
            <audio src="ok_dni.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_379"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <field name="telefono" type="string">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <prompt>Espere un momento, por favor.</prompt>
        <filled>
          <if cond="telefono != ''">
            <audio src="ok_telefono.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_379"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="codigoPostal" type="number">
        <grammar type="application/srgs+xml" src="codigoPostal.grxml"/>
        <prompt>A que hora prefiere pasar?</prompt>
        <filled>
