  <form id="reserva_410">
    <block>
      <prompt>
        50/50 A que hora prefiere pasar?
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="date">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <filled>
          <goto next="#facturacion_320"/>
        </filled>
      </field>
      <field name="telefono" type="string">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <prompt>Confirme los datos, por favor.</prompt>
        <filled>
          <if cond="telefono != ''">
            <audio src="ok_telefono.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_320"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="codigoPostal" type="number">
        <grammar type="application/srgs+xml" src="codigoPostal.grxml"/>
