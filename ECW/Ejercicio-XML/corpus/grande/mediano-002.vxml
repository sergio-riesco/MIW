          <reprompt/>
        </nomatch>
      </field>
      <field name="importe" type="digits">
        <grammar type="application/srgs+xml" src="importe.grxml"/>
        <filled>
          <goto next="#facturacion_320"/>
        </filled>
      </field>
      <field name="fecha" type="number">
        <grammar type="application/srgs+xml" src="fecha.grxml"/>
        <filled>
          <goto next="#facturacion_320"/>
        </filled>
      </field>
