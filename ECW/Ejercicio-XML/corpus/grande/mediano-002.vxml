            <audio src="ok_correo.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_837"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="direccion" type="boolean">
        <grammar type="application/srgs+xml" src="direccion.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="direccion != ''">
            <audio src="ok_direccion.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_837"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <field name="ciudad" type="boolean">
        <grammar type="application/srgs+xml" src="ciudad.grxml"/>
        <prompt>A que hora prefiere pasar?</prompt>
        <filled>
          <if cond="ciudad != ''">
            <audio src="ok_ciudad.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_837"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="provincia" type="number">
        <grammar type="application/srgs+xml" src="provincia.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="provincia != ''">
            <audio src="ok_provincia.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_837"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="referencia" type="date">
        <grammar type="application/srgs+xml" src="referencia.grxml"/>
        <prompt>Espere un momento, por favor.</prompt>
        <filled>
          <if cond="referencia != ''">
            <audio src="ok_referencia.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_837"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <exit/>
    </block>
  </form>
</vxml>
