<vxml xmlns="http://www.w3.org/2001/vxml" version="2.1" xml:lang="es-ES">
  <form id="reserva_388">
    <block>
      <prompt>
        Indique el codigo postal.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="string">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <filled>
          <goto next="#facturacion_233"/>
        </filled>
      </field>
      <field name="telefono" type="boolean">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <prompt>A que hora prefiere pasar?</prompt>
        <filled>
          <if cond="telefono != ''">
            <audio src="ok_telefono.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_233"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="codigoPostal" type="string">
        <grammar type="application/srgs+xml" src="codigoPostal.grxml"/>
        <prompt>Diga su numero de identidad.</prompt>
        <filled>
          <if cond="codigoPostal != ''">
            <audio src="ok_codigoPostal.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_233"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#facturacion_233"/>
      <exit/>
    </block>
  </form>
