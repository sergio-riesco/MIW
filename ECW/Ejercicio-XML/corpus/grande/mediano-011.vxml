  <form id="perfil1_874">
    <block>
      <prompt>
        Indique el codigo postal.
        <break time="300ms"/>
      </prompt>
      <field name="codigoPostal" type="digits">
        <grammar type="application/srgs+xml" src="codigoPostal.grxml"/>
        <filled>
          <goto next="#acceso1_613"/>
        </filled>
      </field>
      <field name="importe" type="number">
        <grammar type="application/srgs+xml" src="importe.grxml"/>
        <filled>
          <goto next="#acceso1_613"/>
        </filled>
      </field>
      <field name="fecha" type="digits">
        <grammar type="application/srgs+xml" src="fecha.grxml"/>
        <prompt>Espere un momento, por favor.</prompt>
        <filled>
          <if cond="fecha != ''">
            <audio src="ok_fecha.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_613"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#acceso1_613"/>
      <exit/>
    </block>
  </form>
  <form id="acceso1_613">
    <block>
      <prompt>
        Le quedan dos intentos.
        <break time="300ms"/>
      </prompt>
      <field name="hora" type="string">
        <grammar type="application/srgs+xml" src="hora.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="hora != ''">
            <audio src="ok_hora.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_613"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="correo" type="boolean">
        <grammar type="application/srgs+xml" src="correo.grxml"/>
        <prompt>Espere un momento, por favor.</prompt>
        <filled>
          <if cond="correo != ''">
            <audio src="ok_correo.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_613"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="direccion" type="boolean">
        <grammar type="application/srgs+xml" src="direccion.grxml"/>
        <filled>
          <goto next="#acceso1_613"/>
        </filled>
      </field>
      <field name="ciudad" type="date">
        <grammar type="application/srgs+xml" src="ciudad.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="ciudad != ''">
            <audio src="ok_ciudad.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_613"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <exit/>
    </block>
  </form>
</vxml>
