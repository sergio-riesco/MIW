<vxml xmlns="http://www.w3.org/2001/vxml" version="2.1" xml:lang="es-ES">
  <form id="reserva_119">
    <block>
      <prompt>
        Gracias por su llamada.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="date">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <prompt>Diga su numero de identidad.</prompt>
        <filled>
          <if cond="dni != ''">
            <audio src="ok_dni.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_432"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="telefono" type="date">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <filled>
          <goto next="#facturacion_432"/>
        </filled>
      </field>
      <field name="codigoPostal" type="boolean">
        <grammar type="application/srgs+xml" src="codigoPostal.grxml"/>
        <prompt>Confirme los datos, por favor.</prompt>
        <filled>
          <if cond="codigoPostal != ''">
            <audio src="ok_codigoPostal.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_432"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <goto next="#facturacion_432"/>
      <exit/>
    </block>
  </form>
