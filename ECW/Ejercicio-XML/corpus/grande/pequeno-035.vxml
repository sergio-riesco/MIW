<vxml xmlns="http://www.w3.org/2001/vxml" version="2.1" xml:lang="es-ES">
  <form id="reserva_708">
    <block>
      <prompt>
        Diga su numero de identidad.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="date">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <prompt>Espere un momento, por favor.</prompt>
        <filled>
          <if cond="dni != ''">
            <audio src="ok_dni.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_313"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="telefono" type="boolean">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <filled>
          <goto next="#facturacion_313"/>
        </filled>
      </field>
      <goto next="#facturacion_313"/>
    </block>
  </form>
  <form id="facturacion_313">
    <block>
