<vxml xmlns="http://www.w3.org/2001/vxml" version="2.1" xml:lang="es-ES">
  <form id="reserva_565">
    <block>
      <prompt>
        Gracias por su llamada.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="date">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <filled>
          <goto next="#facturacion_482"/>
        </filled>
      </field>
      <field name="telefono" type="string">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <prompt>Elija una de las opciones.</prompt>
        <filled>
          <if cond="telefono != ''">
            <audio src="ok_telefono.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_482"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#facturacion_482"/>
      <exit/>
    </block>
  </form>
