  <form id="facturacion_407">
    <block>
      <prompt>
        Gracias por su llamada.
        <break time="300ms"/>
      </prompt>
      <field name="importe" type="string">
        <grammar type="application/srgs+xml" src="importe.grxml"/>
        <prompt>Diga su numero de identidad.</prompt>
        <filled>
          <if cond="importe != ''">
            <audio src="ok_importe.wav">Correcto.</audio>
          </if>
          <goto next="#cancelacion_651"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#cancelacion_651"/>
    </block>
  </form>
