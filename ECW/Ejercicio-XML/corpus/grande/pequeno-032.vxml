  <form id="reserva_571">
    <block>
      <prompt>
        Diga su numero de identidad.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="number">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <filled>
