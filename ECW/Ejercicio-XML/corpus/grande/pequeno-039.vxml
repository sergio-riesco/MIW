  <form id="reserva_419">
    <block>
      <prompt>
        &amp; Puede repetir la informacion?
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="digits">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <prompt>Elija una de las opciones.</prompt>
        <filled>
          <if cond="dni != ''">
            <audio src="ok_dni.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_444"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#form_que_no_existe"/>
    </block>
  </form>
