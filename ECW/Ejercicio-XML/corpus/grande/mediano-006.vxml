        Le quedan dos intentos.
        <break time="300ms"/>
      </prompt>
      <field name="tipo" type="date">
        <grammar type="application/srgs+xml" src="tipo.grxml"/>
        <prompt>Puede repetir la informacion?</prompt>
        <filled>
          <if cond="tipo != ''">
            <audio src="ok_tipo.wav">Correcto.</audio>
          </if>
          <goto next="#perfil1_327"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="dni" type="number">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <prompt>Elija una de las opciones.</prompt>
        <filled>
          <if cond="dni != ''">
            <audio src="ok_dni.wav">Correcto.</audio>
          </if>
          <goto next="#perfil1_327"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <field name="telefono" type="digits">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <prompt>Puede repetir la informacion?</prompt>
        <filled>
