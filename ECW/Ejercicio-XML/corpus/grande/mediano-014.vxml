            <audio src="ok_tipo.wav">Correcto.</audio>
          </if>
          <goto next="#encuesta1_487"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="dni" type="number">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="dni != ''">
            <audio src="ok_dni.wav">Correcto.</audio>
          </if>
          <goto next="#encuesta1_487"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <field name="telefono" type="date">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <filled>
          <goto next="#encuesta1_487"/>
        </filled>
      </field>
      <goto next="#encuesta1_487"/>
    </block>
  </form>
