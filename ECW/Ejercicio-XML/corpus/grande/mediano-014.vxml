  <form id="reserva_469">
    <block>
      <prompt>
        Gracias por su llamada.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="date">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="dni != ''">
            <audio src="ok_dni.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_804"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="telefono" type="digits">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <prompt>Espere un momento, por favor.</prompt>
        <filled>
          <if cond="telefono != ''">
