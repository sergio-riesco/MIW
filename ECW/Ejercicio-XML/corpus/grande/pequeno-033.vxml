  <form id="reserva_914">
    <block>
      <prompt>
        Gracias por su llamada.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="digits">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <filled>
          <goto next="#facturacion_448"/>
        </filled>
      </field>
      <field name="telefono" type="digits">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <prompt>Espere un momento, por favor.</prompt>
        <filled>
          <if cond="telefono != ''">
            <audio src="ok_telefono.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_448"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="codigoPostal" type="date">
        <grammar type="application/srgs+xml" src="codigoPostal.grxml"/>
        <filled>
          <goto next="#facturacion_448"/>
        </filled>
      </field>
      <goto next="#facturacion_448"/>
    </block>
  </form>
