      <field name="correo" type="boolean">
        <grammar type="application/srgs+xml" src="correo.grxml"/>
        <prompt>Diga su numero de identidad.</prompt>
        <filled>
          <if cond="correo != ''">
            <audio src="ok_correo.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_262"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="direccion" type="date">
        <grammar type="application/srgs+xml" src="direccion.grxml"/>
        <prompt>Espere un momento, por favor.</prompt>
        <filled>
          <if cond="direccion != ''">
            <audio src="ok_direccion.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_262"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="ciudad" type="date">
        <grammar type="application/srgs+xml" src="ciudad.grxml"/>
        <prompt>Confirme los datos, por favor.</prompt>
        <filled>
          <if cond="ciudad != ''">
            <audio src="ok_ciudad.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_262"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="provincia" type="boolean">
        <grammar type="application/srgs+xml" src="provincia.grxml"/>
        <prompt>Confirme los datos, por favor.</prompt>
        <filled>
          <if cond="provincia != ''">
            <audio src="ok_provincia.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_262"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#form_que_no_existe"/>
      <exit/>
    </block>
  </form>
</vxml>
