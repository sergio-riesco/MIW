  <form id="acceso9_880">
    <block>
      <prompt>
        Diga su numero de identidad.
        <break time="300ms"/>
      </prompt>
      <field name="provincia" type="boolean">
        <grammar type="application/srgs+xml" src="provincia.grxml"/>
        <prompt>Espere un momento, por favor.</prompt>
        <filled>
          <if cond="provincia != ''">
            <audio src="ok_provincia.wav">Correcto.</audio>
          </if>
          <goto next="#acceso9_880"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="referencia" type="boolean">
        <grammar type="application/srgs+xml" src="referencia.grxml"/>
        <prompt>Elija una de las opciones.</prompt>
        <filled>
          <if cond="referencia != ''">
            <audio src="ok_referencia.wav">Correcto.</audio>
          </if>
          <goto next="#acceso9_880"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <field name="canal" type="digits">
        <grammar type="application/srgs+xml" src="canal.grxml"/>
        <prompt>Confirme los datos, por favor.</prompt>
        <filled>
          <if cond="canal != ''">
            <audio src="ok_canal.wav">Correcto.</audio>
          </if>
          <goto next="#acceso9_880"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <field name="motivo" type="digits">
        <grammar type="application/srgs+xml" src="motivo.grxml"/>
        <filled>
          <goto next="#acceso9_880"/>
        </filled>
      </field>
      <field name="tipo" type="number">
        <grammar type="application/srgs+xml" src="tipo.grxml"/>
        <filled>
          <goto next="#acceso9_880"/>
        </filled>
      </field>
      <field name="dni" type="date">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <prompt>Diga su numero de identidad.</prompt>
        <filled>
          <if cond="dni != ''">
            <audio src="ok_dni.wav">Correcto.</audio>
          </if>
          <goto next="#acceso9_880"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <exit/>
    </block>
  </form>
</vxml>
