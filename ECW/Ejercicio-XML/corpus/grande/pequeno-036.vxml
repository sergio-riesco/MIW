  <form id="facturacion_219">
    <block>
      <prompt>
        Gracias por su llamada.
        <break time="300ms"/>
      </prompt>
      <field name="importe" type="number">
        <grammar type="application/srgs+xml" src="importe.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="importe != ''">
            <audio src="ok_importe.wav">Correcto.</audio>
          </if>
          <goto next="#cancelacion_859"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#cancelacion_859"/>
      <exit/>
    </block>
  </form>
