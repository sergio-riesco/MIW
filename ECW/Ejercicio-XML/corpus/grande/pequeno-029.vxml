          </if>
          <goto next="#facturacion_906"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="codigoPostal" type="boolean">
        <grammar type="application/srgs+xml" src="codigoPostal.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
