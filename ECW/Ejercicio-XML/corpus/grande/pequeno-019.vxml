<vxml xmlns="http://www.w3.org/2001/vxml" version="2.1" xml:lang="es-ES">
  <form id="reserva_655">
    <block>
      <prompt>
        Diga su numero de identidad.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="date">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <filled>
          <goto next="#facturacion_238"/>
        </filled>
      </field>
      <field name="telefono" type="boolean">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="telefono != ''">
            <audio src="ok_telefono.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_238"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#facturacion_238"/>
      <exit/>
    </block>
  </form>
