  <form id="acceso1_395">
    <block>
      <prompt>
        Diga su numero de identidad.
        <break time="300ms"/>
      </prompt>
      <field name="hora" type="number">
        <grammar type="application/srgs+xml" src="hora.grxml"/>
        <prompt>A que hora prefiere pasar?</prompt>
