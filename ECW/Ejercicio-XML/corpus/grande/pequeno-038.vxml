  <form id="reserva_353">
    <block>
      <prompt>
        3 &lt; 5 A que hora prefiere pasar?
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="digits">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="dni != ''">
            <audio src="ok_dni.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_831"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <goto next="#reserva_353"/>
      <exit/>
    </block>
  </form>
