  <form id="reserva_274">
    <block>
      <prompt>
        Diga su numero de identidad.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="string">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <filled>
          <goto next="#facturacion_401"/>
        </filled>
      </field>
      <field name="telefono" type="digits">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <prompt>Puede repetir la informacion?</prompt>
        <filled>
          <if cond="telefono != ''">
            <audio src="ok_telefono.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_401"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <field name="codigoPostal" type="date">
        <grammar type="application/srgs+xml" src="codigoPostal.grxml"/>
        <prompt>A que hora prefiere pasar?</prompt>
        <filled>
          <if cond="codigoPostal != ''">
            <audio src="ok_codigoPostal.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_401"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#facturacion_401"/>
    </block>
  </form>
