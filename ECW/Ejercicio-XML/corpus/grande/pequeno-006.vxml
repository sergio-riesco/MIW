  <form id="reserva_495">
    <block>
      <prompt>
        Indique el codigo postal.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="number">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <filled>
          <goto next="#facturacion_449"/>
        </filled>
      </field>
      <field name="telefono" type="number">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <prompt>Elija una de las opciones.</prompt>
        <filled>
          <if cond="telefono != ''">
            <audio src="ok_telefono.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_449"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#form_que_no_existe"/>
    </block>
  </form>
