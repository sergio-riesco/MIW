  <form id="reserva_774">
    <block>
      <prompt>
        Gracias por su llamada.
        <break time="300ms"/>
      </prompt>
      <field name="dni" type="string">
        <grammar type="application/srgs+xml" src="dni.grxml"/>
        <prompt>Elija una de las opciones.</prompt>
        <filled>
          <if cond="dni != ''">
            <audio src="ok_dni.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_679"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="telefono" type="digits">
        <grammar type="application/srgs+xml" src="telefono.grxml"/>
        <prompt>Elija una de las opciones.</prompt>
        <filled>
          <if cond="telefono != ''">
            <audio src="ok_telefono.wav">Correcto.</audio>
          </if>
          <goto next="#facturacion_679"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <goto next="#facturacion_679"/>
      <exit/>
    </block>
