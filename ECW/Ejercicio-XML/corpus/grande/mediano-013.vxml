          <reprompt/>
        </nomatch>
      </field>
      <field name="correo" type="digits">
        <grammar type="application/srgs+xml" src="correo.grxml"/>
        <filled>
          <goto next="#acceso1_527"/>
        </filled>
      </field>
      <field name="direccion" type="date">
        <grammar type="application/srgs+xml" src="direccion.grxml"/>
        <filled>
          <goto next="#acceso1_527"/>
        </filled>
      </field>
      <field name="ciudad" type="number">
        <grammar type="application/srgs+xml" src="ciudad.grxml"/>
        <prompt>A que hora prefiere pasar?</prompt>
        <filled>
          <if cond="ciudad != ''">
            <audio src="ok_ciudad.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_527"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="provincia" type="boolean">
        <grammar type="application/srgs+xml" src="provincia.grxml"/>
        <prompt>Indique el codigo postal.</prompt>
        <filled>
          <if cond="provincia != ''">
            <audio src="ok_provincia.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_527"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="referencia" type="string">
        <grammar type="application/srgs+xml" src="referencia.grxml"/>
        <prompt>Diga su numero de identidad.</prompt>
        <filled>
          <if cond="referencia != ''">
            <audio src="ok_referencia.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_527"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <exit/>
    </block>
  </form>
</vxml>
