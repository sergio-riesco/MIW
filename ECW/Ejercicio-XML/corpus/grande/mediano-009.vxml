        <prompt>Diga su numero de identidad.</prompt>
        <filled>
          <if cond="importe != ''">
            <audio src="ok_importe.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_836"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <field name="fecha" type="digits">
        <grammar type="application/srgs+xml" src="fecha.grxml"/>
        <prompt>Puede repetir la informacion?</prompt>
        <filled>
          <if cond="fecha != ''">
            <audio src="ok_fecha.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_836"/>
        </filled>
        <nomatch>
          No le he entendido.
        </nomatch>
      </field>
      <goto next="#acceso1_836"/>
      <exit/>
    </block>
  </form>
  <form id="acceso1_836">
    <block>
      <prompt>
        Gracias por su llamada.
        <break time="300ms"/>
      </prompt>
      <field name="hora" type="boolean">
        <grammar type="application/srgs+xml" src="hora.grxml"/>
        <filled>
          <goto next="#acceso1_836"/>
        </filled>
      </field>
      <field name="correo" type="digits">
        <grammar type="application/srgs+xml" src="correo.grxml"/>
        <filled>
          <goto next="#acceso1_836"/>
        </filled>
      </field>
      <field name="direccion" type="date">
        <grammar type="application/srgs+xml" src="direccion.grxml"/>
        <prompt>Diga su numero de identidad.</prompt>
        <filled>
          <if cond="direccion != ''">
            <audio src="ok_direccion.wav">Correcto.</audio>
          </if>
          <goto next="#acceso1_836"/>
        </filled>
        <nomatch>
          Repita, por favor.
          <reprompt/>
        </nomatch>
      </field>
      <exit/>
    </block>
  </form>
</vxml>
